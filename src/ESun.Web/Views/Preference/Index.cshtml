@model ESun.Web.Models.PreferenceIndexViewModel
@{
    ViewData["Title"] = "喜好金融商品清單";
}

<h2>喜好金融商品清單</h2>
<hr />

@* PRG 模式：TempData 訊息顯示一次即消失，避免重新整理重複送出 *@
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="關閉"></button>
    </div>
}

<div class="d-flex flex-wrap align-items-end gap-3 mb-3">

    <form asp-action="SelectUser" method="post" class="mb-0">
        <label class="form-label mb-1">選擇使用者</label>
        <select name="userId" asp-items="Model.UserOptions"
                class="form-select" style="min-width: 220px;"
                onchange="this.form.submit()">
            <option value="">-- 請選擇使用者 --</option>
        </select>
    </form>

    @if (!string.IsNullOrEmpty(Model.CurrentUserId))
    {
        @if (Model.Items.Any())
        {
            @* 前端即時篩選（見頁尾 Scripts）：只過濾已載入的列，不打後端 *@
            <div>
                <label class="form-label mb-1">搜尋產品名稱</label>
                <input type="text" id="filterBox" class="form-control" style="min-width: 220px;"
                       placeholder="輸入產品名稱關鍵字…" autocomplete="off" />
            </div>
        }

        <a asp-action="Create" class="btn btn-primary ms-auto">＋ 新增喜好商品</a>
    }
</div>

@if (string.IsNullOrEmpty(Model.CurrentUserId))
{
    <div class="alert alert-info">請先從上方選擇使用者，以檢視其喜好清單。</div>
}
else if (!Model.Items.Any())
{
    <div class="alert alert-secondary">這位使用者目前沒有任何喜好商品。</div>
}
else
{
    @* table-responsive：窄螢幕可橫向捲動（RWD）*@
    <div class="table-responsive">
        <table id="prefTable" class="table table-striped table-hover align-middle text-center">
            <thead>
                <tr>
                    <th>產品名稱</th>
                    <th>產品價格（台幣）</th>
                    <th>扣款帳號</th>
                    <th>購買數量</th>
                    <th>總手續費（台幣）</th>
                    <th>預計扣款總金額（台幣）</th>
                    <th>Email</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @* @item.X 以 @ 輸出會自動 HTML 編碼 → 防 XSS *@
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Price.ToString("N2")</td>
                        <td>@item.Account</td>
                        <td>@item.PurchaseQuantity.ToString("N0")</td>
                        <td>@item.TotalFee.ToString("N2")</td>
                        <td>@item.TotalAmount.ToString("N2")</td>
                        <td>@item.Email</td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.SN" class="btn btn-sm btn-outline-primary">編輯</a>
                            <a asp-action="Delete" asp-route-id="@item.SN" class="btn btn-sm btn-outline-danger">刪除</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        document.getElementById('filterBox')?.addEventListener('input', function () {
            const kw = this.value.trim().toLowerCase();
            document.querySelectorAll('#prefTable tbody tr').forEach(tr => {
                const name = tr.cells[0].textContent.toLowerCase();
                tr.style.display = name.includes(kw) ? '' : 'none';
            });
        });
    </script>
}
